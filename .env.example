# chio-developer-base environment template
# ------------------------------------------
# Copy this file to `.env` before running the Phase 1 stack:
#     cp .env.example .env
#     $EDITOR .env
#
# Secrets stay local. The repository tracks `.env.example` only — `.env` is
# in `.gitignore`.
#
# Inherited and lightly adapted from arc PR #599's
# ops/knowledge-base/.env.example. The notable adaptation is CHIO_KB_REPO_ROOT,
# which now points at sibling repo paths since chio-developer-base lives
# alongside arc rather than inside it.

# === Repo paths ===

# Path to the arc clone that the indexer reads from. Relative to
# chio-developer-base/. Override in .env or via `make ARC_REPO=…`.
ARC_REPO=../arc

# Repo root the indexer treats as the source of truth. Inside the docker
# stack this is bind-mounted; on the host it should resolve to ARC_REPO.
CHIO_KB_REPO_ROOT=../arc

# === LLM / embeddings (Graphiti + optional CocoIndex extraction) ===

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
CHIO_KB_LLM_MODEL=openai/gpt-4o-mini
CHIO_KB_LLM_EXTRACT=1

# Default embedding backend. A future local profile can swap this for
# sentence-transformers; the A-grade profile uses text-embedding-3-small.
CHIO_KB_EMBED_MODEL=text-embedding-3-small

# Concurrency knobs. Reduce if your laptop is memory-constrained on the
# Neo4j + Graphiti combo (Neo4j is the hungry one).
CHIO_KB_MAX_INFLIGHT_COMPONENTS=8
COCOINDEX_SOURCE_MAX_INFLIGHT_ROWS=8
SEMAPHORE_LIMIT=5

# === Neo4j (Chio property graph) ===

NEO4J_USER=neo4j
NEO4J_PASSWORD=demodemo
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687

GRAPHITI_GROUP_ID=chio-repo
GRAPHITI_TELEMETRY_ENABLED=false

# === pgvector (semantic code/docs index) ===

COCOINDEX_DB=.cocoindex/chio-kb
POSTGRES_DB=chio_kb
POSTGRES_USER=cocoindex
POSTGRES_PASSWORD=cocoindex
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost:55432/chio_kb

# Per-pack schema inside the Postgres database. Default `chio_kb` keeps
# the legacy stack working; set to `alexandria_kb`, `opus_kb`, etc. when
# multiple packs share one database (M1-Multitenant deliverable 3).
CHIO_KB_PACK_SCHEMA=chio_kb

# === Service ports ===

# chio-kb MCP gateway. Health: http://localhost:8111/health
CHIO_KB_MCP_HOST=0.0.0.0
CHIO_KB_MCP_PORT=8111

# Graphiti MCP. Health: http://localhost:8000/health
GRAPHITI_MCP_URL=http://localhost:8000/mcp
GRAPHITI_MCP_HOST_HEADER=

# === Phase 2B (signed retrieval) ===
# Capability for the gateway. The gateway boots only with a valid grant.
# Phase 2B will document how to mint this; until then leave blank.
CHIO_KB_GATEWAY_CAPABILITY=
