# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv — per PR #599 convention, lockfiles are ignored
.venv/
chio-pack/uv.lock
kb-engine/uv.lock

# Local secrets (track only `.env.example`)
.env
.env.local
*.local

# CocoIndex runtime state (Phase 1)
.cocoindex/

# === Obsidian ===
# .obsidian/ holds the canonical config (community-plugins.json,
# core-plugins.json, snippets, plugin data.json defaults, custom plugin source).
# These specific files inside it are per-user/per-machine and NOT tracked:
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.obsidian/app.json
# hotkeys.json IS committed (canonical default bindings — see vault/_meta/hotkeys.md);
# users override locally in Obsidian's Hotkeys settings, which writes to this file.
# Skip-worktree on conflict: `git update-index --skip-worktree .obsidian/hotkeys.json`

# Themes are user-installed
.obsidian/themes/

# Plugin code is downloaded by Obsidian on first launch for community plugins.
# For OUR custom plugins, main.js is committed (re-enabled below) so a fresh
# checkout has working plugins without an npm build step on first launch.
.obsidian/plugins/*/main.js
!.obsidian/plugins/episode-promoter/main.js
!.obsidian/plugins/kb-staleness-badge/main.js
.obsidian/plugins/*/main.js.map
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/versions.json

# Community plugin manifests are part of their downloaded distribution.
# Only our custom plugin's manifest and versions.json are committed
# (they're authored, not downloaded).
.obsidian/plugins/*/manifest.json
!.obsidian/plugins/episode-promoter/manifest.json
!.obsidian/plugins/episode-promoter/versions.json
!.obsidian/plugins/kb-staleness-badge/manifest.json
!.obsidian/plugins/kb-staleness-badge/versions.json

# OS / Editor
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/settings.json
