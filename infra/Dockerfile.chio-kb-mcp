# chio-kb-mcp gateway. Wave 1 / Phase 1.3 build context.
#
# Builds an image with kb-engine + chio-pack installed and runs the real
# MCP gateway (infra/chio-kb-mcp-server.py) hosting the 10 kb_* tools.
#
# Build context is the REPO ROOT (..) — see docker-compose.yml.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY kb-engine/ /app/kb-engine/
COPY chio-pack/ /app/chio-pack/
RUN uv pip install --system --no-cache "/app/kb-engine[all]" /app/chio-pack

# Real MCP gateway (Wave 1). Replaces the Phase 1.1 health stub.
COPY infra/chio-kb-mcp-server.py /app/server.py

# Retrieval fixtures + eval entrypoint for `make kb-eval-retrieval`.
COPY kb-engine/eval/ /app/kb-engine/eval/
COPY chio-pack/eval/ /app/chio-pack/eval/
COPY vault/ /vault/

EXPOSE 8111
CMD ["python", "/app/server.py"]
